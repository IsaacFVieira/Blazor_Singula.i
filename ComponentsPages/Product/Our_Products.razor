@using Singular.ComponentsPages.Product.Cads
<section class="products-section">
    <div class="products-container">
        <div class="products-header">
            <h1 class="products-title">Nossos Produtos</h1>
            <p class="products-description">Conheça os produtos que estamos a desenvolver para transformar Angola através da tecnologia</p>
            <button class="status-check-button">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                Verificar Status do Pedido
            </button>
        </div>
        <div class="products-grid">
            <Product Title="Doctor+" Description="Sistema de rastreamento de saúde para acesso e gestão de informações de pacientes." Category="Saúde" IconSrc="/images/D+.PNG" Link="/products/doctor-plus" />
            <Product Title="JAFADH" Description="Sistema de verificação de documentação pessoal." Category="Segurança" IconSrc="/images/JAFADH_com_fundo .PNG" Link="/products/jafadh" />
        </div>
    </div>
</section>

