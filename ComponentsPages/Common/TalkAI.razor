@using Microsoft.AspNetCore.Components.Web

<div class="ai-chat-widget">
    <button class="ai-chat-button" @onclick="ToggleChat" title="Chat with Singular AI">
        <svg class="ai-chat-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 8a2 2 0 0 1 2 2v2H10v-2a2 2 0 0 1 2-2z"></path>
            <path d="M12 2a2 2 0 0 1 2 2v2H10V4a2 2 0 0 1 2-2z"></path>
            <rect x="8" y="6" width="8" height="12" rx="1"></rect>
            <path d="M8 10h8"></path>
            <path d="M8 14h8"></path>
        </svg>
    </button>
    
    @if (isOpen)
    {
        <div class="ai-chat-window">
            <div class="ai-chat-header">
                <div class="ai-chat-header-content">
                    <svg class="ai-chat-header-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 8a2 2 0 0 1 2 2v2H10v-2a2 2 0 0 1 2-2z"></path>
                        <path d="M12 2a2 2 0 0 1 2 2v2H10V4a2 2 0 0 1 2-2z"></path>
                        <rect x="8" y="6" width="8" height="12" rx="1"></rect>
                        <path d="M8 10h8"></path>
                        <path d="M8 14h8"></path>
                    </svg>
                    <div class="ai-chat-header-text">
                        <h3 class="ai-chat-title">Singular AI</h3>
                        <p class="ai-chat-subtitle">Powered by AI</p>
                    </div>
                </div>
                <button class="ai-chat-close" @onclick="ToggleChat">
                    <svg class="close-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <div class="ai-chat-messages">
                <div class="ai-message ai-message-bot">
                    <p>Olá! Sou a Singular IA. Posso responder perguntas sobre a SINGULAR.i, os seus serviços e os seus produtos. Como posso ajudar?</p>
                </div>
            </div>
            <div class="ai-chat-input">
                <input type="text" placeholder="Escreva a sua mensagem..." class="ai-chat-textbox" @bind="message" @onkeypress="HandleKeyPress" />
                <button class="ai-chat-send" @onclick="SendMessage" disabled="@string.IsNullOrWhiteSpace(message)">
                    <svg class="send-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool isOpen = false;
    private string message = string.Empty;

    private void ToggleChat()
    {
        isOpen = !isOpen;
    }

    private void HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SendMessage();
        }
    }

    private void SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(message))
        {
            // In a real implementation, this would send the message to an AI service
            message = string.Empty;
        }
    }
}
