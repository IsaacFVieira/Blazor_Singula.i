@using Singular.Services
@inject NavigationManager Navigation
@inject ThemeService ThemeService

<footer class="footer">
    <div class="footer-container">
        <div class="footer-section">
            <div class="footer-logo">
                <img src="@LogoSrc" alt="SINGULAR.i" class="footer-logo-image" @onclick="NavigateToHome" />
            </div>
            <p class="footer-description">
                Soluções modernas em desenvolvimento de software. Criamos sistemas digitais, plataformas web e soluções tecnológicas focadas em resolver problemas reais.
            </p>
        </div>
        <div class="footer-section">
            <h3 class="footer-title">Links</h3>
            <nav class="footer-nav">
                <a href="/" class="footer-link">Home</a>
                <a href="/sobre" class="footer-link">Sobre</a>
                <a href="/products" class="footer-link">Produtos</a>
                <a href="/contacto" class="footer-link">Contacto</a>
            </nav>
        </div>
        <div class="footer-section">
            <h3 class="footer-title">Contact</h3>
            <div class="footer-contact">
                <h4>Contacto</h4>
                <ul>
                    <li>
                        <svg class="contact-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                        </svg>
                        <a href="mailto:singular.i.ao@gmail.com">singular.i.ao@gmail.com</a>
                    </li>
                    <li>
                        <svg class="contact-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                        <span>+244 946 570 104 / +244 958 736 918</span>
                    </li>
                    <li>
                        <svg class="contact-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <span>Luanda, Angola</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <div class="footer-bottom-container">
            <a href="mailto:singular.i.ao@gmail.com" class="footer-bottom-link">singular.i.ao@gmail.com</a>
            <p class="footer-copyright"> 2026 SINGULAR.i. Todos os direitos reservados.</p>
        </div>
    </div>
</footer>

@code {
    private string currentTheme = "dark";
    private string LogoSrc => currentTheme == "dark" ? "/images/singular_horizontal_branco.svg" : "/images/aceite1.svg";

    protected override async Task OnInitializedAsync()
    {
        currentTheme = await ThemeService.GetCurrentThemeAsync();
    }

    private void NavigateToHome()
    {
        Navigation.NavigateTo("/");
    }
}
