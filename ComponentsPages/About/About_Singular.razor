@using Singular.Services
@inject ThemeService ThemeService

<section class="about-hero-section" style="padding: 6rem 1rem 2rem; background: linear-gradient(to bottom right, var(--bg-card), var(--bg-surface));">
    <div class="about-hero-container" style="max-width: 56rem; margin: 0 auto;">
        <div class="about-hero-content" style="text-align: center; padding: 0 1rem;">
            <div class="about-hero-logo" style="display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 1.5rem;">
                <img src="@LogoSrc" alt="Singular.i" class="about-hero-logo-image" style="height: 4.5rem; width: auto;" />
            </div>
            <h1 class="about-hero-title" style="font-size: 1.875rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1.5rem;">Sobre a SINGULAR.i</h1>
            <div class="about-hero-description">
                <p class="about-hero-text-primary" style="font-size: 1.125rem; color: var(--text-secondary); line-height: 1.75; margin-bottom: 1rem;">
                    A SINGULAR.i É UMA INICIATIVA FOCADA NA MATERIALIZAÇÃO SAUDÁVEL, EFICIENTE E CONTEXTUALIZADA DE PROJECTOS TECNOLÓGICOS, ESPECIALMENTE AQUELES IDEALIZADOS POR ESTUDANTES.
                </p>
                <p class="about-hero-text-secondary" style="font-size: 1rem; color: var(--text-secondary); line-height: 1.75; margin-bottom: 1rem;">
                    Trabalhamos para transformar desafios reais em soluções práticas, ajudando instituições a optimizar processos, aumentar a eficiência e impulsionar o crescimento. Combinamos análise estratégica, desenvolvimento de software e inovação para criar soluções adaptadas às necessidades específicas de cada contexto.
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private string currentTheme = "dark";
    private string LogoSrc => currentTheme == "dark" ? "/images/singular_horizontal_branco.svg" : "/images/aceite1.svg";

    protected override async Task OnInitializedAsync()
    {
        currentTheme = await ThemeService.GetCurrentThemeAsync();
    }
}
