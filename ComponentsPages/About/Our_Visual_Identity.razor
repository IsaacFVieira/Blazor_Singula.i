        <div class="identity-grid" style="display: grid; grid-template-columns: 1fr; gap: 1rem;">
            <div class="identity-card" style="background-color: #282a36; padding: 1.25rem; border-radius: 0.75rem; border: 1px solid #282a36;">
                <div class="identity-color-box identity-color-white" style="width: 3rem; height: 3rem; border-radius: 0.5rem; margin-bottom: 1rem; background-color: #ffffff; border: 2px solid #ffffff;"></div>
                <h3 class="identity-color-title" style="font-weight: 600; margin-bottom: 0.5rem; color: #ffffff;">Branco</h3>
                <p class="identity-color-description" style="color: #a0a0a0; font-size: 0.875rem;">Clareza e simplicidade</p>
            </div>
            <div class="identity-card" style="background-color: #282a36; padding: 1.25rem; border-radius: 0.75rem; border: 1px solid #282a36;">
                <div class="identity-color-box identity-color-green" style="width: 3rem; height: 3rem; border-radius: 0.5rem; margin-bottom: 1rem; background-color: #00ff9d;"></div>
                <h3 class="identity-color-title" style="font-weight: 600; margin-bottom: 0.5rem; color: #ffffff;">Verde Vibrante</h3>
                <p class="identity-color-description" style="color: #a0a0a0; font-size: 0.875rem;">Tecnologia e confiança</p>
            </div>
            <div class="identity-card" style="background-color: #282a36; padding: 1.25rem; border-radius: 0.75rem; border: 1px solid #282a36;">
                <div class="identity-color-box identity-color-graphite" style="width: 3rem; height: 3rem; border-radius: 0.5rem; margin-bottom: 1rem; background-color: #00ff9d;"></div>
                <h3 class="identity-color-title" style="font-weight: 600; margin-bottom: 0.5rem; color: #ffffff;">Grafite</h3>
                <p class="identity-color-description" style="color: #a0a0a0; font-size: 0.875rem;">Inovação e destaque</p>
            </div>
        </div>
        <p class="identity-interface" style="font-size: 0.875rem; color: #a0a0a0; margin-top: 1.5rem;">Interface limpa, responsiva e inspirada em sistemas SaaS modernos.</p>
    </div>
</section>

