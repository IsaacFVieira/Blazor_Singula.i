<section class="contact-section">
    <div class="contact-container">
        <div class="contact-header">
            <h1 class="contact-title">Contacte-nos</h1>
            <p class="contact-description">Entre em contacto connosco para discutir o seu projeto</p>
        </div>
        <div class="contact-grid">
            <div class="contact-info">
                <h2 class="contact-info-title">Informações de Contacto</h2>
                <div class="contact-info-cards">
                    <div class="contact-info-card">
                        <h3 class="contact-info-label">Email</h3>
                        <p class="contact-info-value">singular.i.ao@gmail.com</p>
                    </div>
                    <div class="contact-info-card">
                        <h3 class="contact-info-label">Telefone</h3>
                        <p class="contact-info-value">+244 946 570 104 / +244 958 736 918</p>
                    </div>
                    <div class="contact-info-card">
                        <h3 class="contact-info-label">Localização</h3>
                        <p class="contact-info-value">Huambo, Angola</p>
                    </div>
                </div>
            </div>
            <div class="contact-form-wrapper">
                <h2 class="contact-form-title">Envie uma Mensagem</h2>
                <form class="contact-form">
                    <div class="form-field">
                        <label class="form-label" for="nome">Nome</label>
                        <input type="text" id="nome" class="form-input" placeholder="Seu nome" />
                    </div>
                    <div class="form-field">
                        <label class="form-label" for="email">Email</label>
                        <input type="email" id="email" class="form-input" placeholder="seu@email.com" />
                    </div>
                    <div class="form-field">
                        <label class="form-label" for="mensagem">Mensagem</label>
                        <textarea id="mensagem" rows="4" class="form-textarea" placeholder="Sua mensagem"></textarea>
                    </div>
                    <button type="submit" class="form-submit-button">Enviar Mensagem</button>
                </form>
            </div>
        </div>
    </div>
</section>

