<div class="service-card" style="background-color: #282a36; padding: 1.5rem; border-radius: 0.75rem; height: 100%;">
    <div class="service-icon" style="width: 3rem; height: 3rem; background-color: #282a36; border-radius: 0.5rem; margin-bottom: 1rem; display: flex; align-items: center; justify-content: center;">
        <div style="width: 1.5rem; height: 1.5rem; background-color: #00ff9d; border-radius: 0.25rem;"></div>
    </div>
    <h3 class="service-title" style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.5rem; color: #ffffff;">@Title</h3>
    <p class="service-description" style="font-size: 0.875rem; color: #a0a0a0; line-height: 1.75;">@Description</p>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Description { get; set; } = string.Empty;
}
