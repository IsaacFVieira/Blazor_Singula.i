@using Singular.ComponentsPages.Service.Cads;

<section class="services-section">
    <div class="services-container">
        <div class="services-header">
            <h1 class="services-title">Nossos Serviços</h1>
            <p class="services-description">Soluções tecnológicas completas para impulsionar o seu negócio</p>
        </div>
        <div class="services-grid">
            <Service Title="Design Gráfico" Description="Podemos criar, melhorar, personalizar o design de qualquer elemento da sua identidade visual, para melhor representar o seu negócio. Desenvolvedores podem se focar em outras fases do projecto, e confiar à nós a sua interface gráfica." />
            <Service Title="Consultoria Técnica para Elaboração de Projectos" Description="Ajudamos a transformar ideias em projectos sólidos, prontos para a modelagem." />
            <Service Title="Planeamento e Modelagem de Sistemas" Description="Para programadores, ou qualquer que tenha já garantidos os serviços de desenvolvimento, auxiliamos a modelar o sistema, para garantir o desenvolvimento estruturado, documentação e melhor comunicação com equipa." />
            <Service Title="Desenvolvimento de Sistemas" Description="Contamos com um repertório rico de projectos para resolver os mais variados problemas sociais. Clientes podem também confiar à nós os seus projectos ou ideias de projectos, desde a concepção à implementação ao mercado." />
        </div>
    </div>
</section>

